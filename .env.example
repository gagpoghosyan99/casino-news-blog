# Site URL (used for referral redirects)
NEXT_PUBLIC_SITE_URL=https://zeonebet.com

# ===========================================
# AUTH + EMAIL VERIFICATION
# ===========================================
# Long random secret for JWT session cookies (32+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Where user accounts + verification codes are stored (JSON file).
# On the VPS use a path outside the deploy wipe, e.g.:
# AUTH_DATA_DIR=/var/www/casino-news-blog/data/auth
AUTH_DATA_DIR=

# SMTP — required in production to email 6-digit verification codes.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com
# SMTP_PASS=<App Password> SMTP_FROM="ZEONEBET <you@gmail.com>"
# Or use Resend / SendGrid / Mailgun SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZEONEBET <noreply@zeonebet.com>"

# Optional webhook for /partners business inquiries (POST JSON)
PARTNERS_INQUIRY_WEBHOOK_URL=

# ===========================================
